JARVIS_APP_NAME=Jarvis
JARVIS_ENVIRONMENT=development
JARVIS_LOG_LEVEL=INFO
JARVIS_WINDOW_WIDTH=460
JARVIS_WINDOW_HEIGHT=620
JARVIS_ALWAYS_ON_TOP=true
JARVIS_MINIMIZE_TO_TRAY=true
VOICE_SAMPLE_RATE=16000
VOICE_RECORD_SECONDS=5
VOICE_VAD_THRESHOLD=0.0015
JARVIS_VOICE_CHANNELS=1
JARVIS_VOICE_VAD_ENABLED=true
STT_PROVIDER=faster_whisper
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WAKE_PHRASE=hey jarvis
WAKE_ALIASES=hey jarvis,hi jarvis,wake up jarvis,jarvis wake up,okay jarvis,yo jarvis
WAKE_MATCH_THRESHOLD=0.72
WAKE_LISTEN_SECONDS=5
VOICE_COMMAND_START_DELAY_SECONDS=1.0
VOICE_COMMAND_RECORD_SECONDS=7
VOICE_LOOP_ENABLED=false
VOICE_LOOP_MAX_EMPTY_COMMANDS=3
VOICE_LOOP_WAKE_COOLDOWN_SECONDS=1.5
VOICE_LOOP_SPEAK_STATUS=true
CONVERSATION_HISTORY_ENABLED=true
CONVERSATION_HISTORY_MAX_MESSAGES=10
MEMORY_ENABLED=true
MEMORY_DATABASE_PATH=data/jarvis_memory.db
REMINDERS_ENABLED=true
REMINDERS_CHECK_ENABLED=true
REMINDERS_CHECK_INTERVAL_SECONDS=60
REMINDERS_SPEAK_DUE=false
REMINDERS_WATCH_ENABLED=false
REMINDERS_WATCH_SPEAK=false
APP_LAUNCHER_ENABLED=true
APP_LAUNCHER_ALLOWED_APPS=notepad=notepad.exe,calculator=calc.exe,chrome=,edge=,vscode=,docker=
WEBSITE_LAUNCHER_ENABLED=true
WEBSITE_ALLOWED_SITES=google=https://www.google.com,youtube=https://www.youtube.com,github=https://github.com,gmail=https://mail.google.com,blackboard=,outlook=https://outlook.office.com
FILE_ACCESS_ENABLED=false
FILE_ACCESS_ALLOWED_FOLDERS=documents=%USERPROFILE%\Documents,desktop=%USERPROFILE%\Desktop,downloads=%USERPROFILE%\Downloads
FILE_READ_ENABLED=false
FILE_READ_MAX_BYTES=20000
FILE_READ_MAX_OUTPUT_CHARS=4000
FILE_READ_ALLOWED_EXTENSIONS=.txt,.md,.csv,.json,.py,.java,.cpp,.h,.html,.css,.js
FILE_SUMMARY_ENABLED=false
FILE_SUMMARY_MAX_CHARS=6000
CONFIRMATION_REQUIRED=true
CONFIRMATION_TIMEOUT_SECONDS=30
NOTIFICATIONS_ENABLED=false
NOTIFICATION_PROVIDER=windows_toast
REMINDERS_TOAST_ENABLED=false
REMINDERS_DATABASE_PATH=data/jarvis_reminders.db
CALENDAR_ENABLED=false
CALENDAR_CREATE_ENABLED=false
CALENDAR_CLIENT_SECRET_PATH=credentials/google_client_secret.json
CALENDAR_TOKEN_PATH=credentials/token_calendar.json
CALENDAR_SCOPES=https://www.googleapis.com/auth/calendar.readonly
CALENDAR_WRITE_SCOPES=https://www.googleapis.com/auth/calendar.events
GMAIL_ENABLED=false
GMAIL_CLIENT_SECRET_PATH=credentials/google_client_secret.json
GMAIL_TOKEN_PATH=credentials/token_gmail.json
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
GMAIL_DRAFT_ENABLED=false
GMAIL_DRAFT_SCOPES=https://www.googleapis.com/auth/gmail.compose
GMAIL_SEND_DRAFT_ENABLED=false
GMAIL_SEND_SCOPES=https://www.googleapis.com/auth/gmail.modify
GMAIL_MAX_RESULTS=5
WEATHER_ENABLED=false
WEATHER_PROVIDER=openweathermap
WEATHER_API_KEY=
WEATHER_DEFAULT_CITY=Nottingham
WEATHER_UNITS=metric
VISION_ENABLED=false
SCREENSHOT_ENABLED=false
OCR_ENABLED=false
SCREENSHOT_SAVE_DIR=logs/screenshots
OCR_PROVIDER=tesseract
OCR_MAX_OUTPUT_CHARS=4000
OPENAI_VISION_ENABLED=false
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_VISION_MAX_IMAGE_BYTES=5000000
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SYSTEM_PROMPT=You are Jarvis, a helpful personal desktop AI assistant.
TTS_ENABLED=false
TTS_PROVIDER=openai
TTS_VOICE_NAME=
TTS_RATE=175
TTS_VOLUME=1.0
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_FORMAT=mp3
OPENAI_TTS_INSTRUCTIONS=Speak as a calm, mature, professional British-inspired desktop AI assistant. Use a confident, clear, cinematic tone. Do not sound childish. Keep the pace natural and efficient.
